# Mediola Eva a.i.o. gateway base URL (no trailing slash)
GATEWAY_URL=http://mediola.local

# Optional gateway auth (only if enabled on the device):
# XC_USER=
# XC_PASS=

# LEARN_TIMEOUT_MS=90000
# TIMEOUT_MS=4000

# Optional HTTP cover bridge (npm run serve)
# Default bind is loopback only. Use 0.0.0.0 only on a trusted LAN.
# NODI_HOST=127.0.0.1
# NODI_PORT=8788
# Recommended when binding beyond loopback:
# NODI_BRIDGE_TOKEN=change-me

# URL Home Assistant uses to reach the bridge host
# (LAN IP of the machine running `serve` if HA is remote):
# HA_BASE_URL=http://127.0.0.1:8788
